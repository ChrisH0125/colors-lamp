{
  "name": "colors-lamp-linting",
  "version": "1.0.0",
  "private": true,
  "description": "Development-only linting tools for the COLORS LAMP application",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:js": "eslint \"public/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "htmlhint": "1.9.2",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
